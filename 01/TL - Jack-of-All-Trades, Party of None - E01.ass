Dialogue: 0,0:00:29.15,0:00:32.82,Main,Orhun,0,0,0,,Belki de endişelendiğim kadar \Nformdan düşmemişimdir.
Dialogue: 0,0:00:32.82,0:00:36.20,Main,Orhun,0,0,0,,{\pos(312,280)}Çeviri:Hana\NSomeSubs
Dialogue: 0,0:00:32.82,0:00:36.20,Main,Orhun,0,0,0,,Hala kılıç ustası olarak başarabilirim, sanırım.
Dialogue: 0,0:00:43.43,0:00:46.31,Main,Orhun,0,0,0,,Destek büyüsünü de denemenin zamanı geldi.
Dialogue: 0,0:00:47.09,0:00:48.39,Main,Orhun,0,0,0,,Güçlendirme.
Dialogue: 0,0:00:51.80,0:00:55.07,Italics,Orhun,0,0,0,,Destek büyüsü, hedeflerinin fiziksel yeteneklerini geliştirir.
Dialogue: 0,0:00:55.07,0:00:57.18,Italics,Orhun,0,0,0,,veya ekipmanlarını güçlendirir.
Dialogue: 0,0:01:00.20,0:01:05.71,Italics,Orhun,0,0,0,,Büyücü bunu sadece parti üyelerine yardım etmek için kullanmakla kalmaz, kendisine de uygulayabilir.
Dialogue: 0,0:01:05.71,0:01:10.13,Italics,Orhun,0,0,0,,Hem saldırı hem de savunmayı artıran büyülerle, her partinin ihtiyacı olan bir şeydir.
Dialogue: 0,0:01:18.89,0:01:25.23,Sign_Basic,Text,0,0,0,,{\an8}BÖLÜM 1: HER İŞİ YAPAN ADAM \N YENİDEN KILIÇ USTASI OLUR
Dialogue: 0,0:01:33.51,0:01:35.49,Italics,Orhun,0,0,0,,Ancak bir zayıflığı da var.
Dialogue: 0,0:01:37.02,0:01:38.09,Italics,Orhun,0,0,0,,Zaman.
Dialogue: 0,0:01:40.28,0:01:42.24,Main,Orhun,0,0,0,,Tam olarak üç dakika, ha?
Dialogue: 0,0:01:44.94,0:01:46.40,Main,Orhun,0,0,0,,Güç Artışı.
Dialogue: 0,0:01:48.55,0:01:52.00,Italics,Orhun,0,0,0,,Destek büyüsü sonsuza kadar sürmez.
Dialogue: 0,0:01:52.76,0:01:57.37,Italics,Orhun,0,0,0,,Ve bir bireyin büyü direnci \N bunun süresini değiştirir.
Dialogue: 0,0:01:57.97,0:02:00.52,Italics,Orhun,0,0,0,,Benim durumumda, 180 saniye sürüyor.
Dialogue: 0,0:02:01.06,0:02:02.46,Main,Orhun,0,0,0,,Üç saniye kaldı...
Dialogue: 0,0:02:02.46,0:02:03.80,Main,Orhun,0,0,0,,Güçlen!
Dialogue: 0,0:02:05.12,0:02:09.32,Italics,Orhun,0,0,0,,Savaşın gidişatını yakından takip etmeli ve doğru zamanda büyü yapmalıyım.
Dialogue: 0,0:02:09.32,0:02:13.48,Italics,Orhun,0,0,0,,Destek büyüsü kullanan büyücüler, sürekli zamanla yarış halindedirler.
Dialogue: 0,0:02:13.93,0:02:18.02,Italics,Orhun,0,0,0,,Normalde, kılıç sallarken \N kullanmaya çalışmazsınız.
Dialogue: 0,0:02:18.02,0:02:19.74,Main,Orhun,0,0,0,,Ama benim durumumda...
Dialogue: 0,0:02:26.73,0:02:30.07,Flashback,Oliver,0,0,0,,Bugün kahramanın partisinden ayrılmanızı rica etmek zorundayız.
Dialogue: 0,0:02:31.31,0:02:33.25,Flashback,Orhun,0,0,0,,Bu bir tür şaka mı, Oliver?
Dialogue: 0,0:02:33.74,0:02:36.38,Flashback,Oliver,0,0,0,,Öyle değil, Orhun.
Dialogue: 0,0:02:36.38,0:02:39.36,Flashback,Orhun,0,0,0,,Neden bahsediyorsun? Biz çocukluk arkadaşıyız!
Dialogue: 0,0:02:39.36,0:02:41.34,Flashback,Orhun,0,0,0,,Her zaman birlikte olan yoldaşlar!
Dialogue: 0,0:02:41.34,0:02:47.07,Flashback,Oliver,0,0,0,,Evet. Şimdiye kadar sana birçok şans verdim çünkü sen de aynı köyden geliyorsun.
Dialogue: 0,0:02:47.07,0:02:50.23,Flashback,Oliver,0,0,0,,Ama bundan sonra, \N ayak uyduramayacaksınız.
Dialogue: 0,0:02:51.27,0:02:53.02,Flashback,Anneli,0,0,0,,Neden açıkça söylemiyorsun?
Dialogue: 0,0:02:53.02,0:02:55.61,Flashback,Derick,0,0,0,,Ona bizi yavaşlattığını söyle.
Dialogue: 0,0:02:56.22,0:02:58.38,Flashback,Orhun,0,0,0,,Anneli? Derick?
Dialogue: 0,0:02:59.21,0:03:01.87,Flashback,Oliver,0,0,0,,{\pos(760,196)}ÇVM: Niye öyle dedinizki ilerde güçlenir ayıp
Dialogue: 0,0:02:59.21,0:03:01.87,Flashback,Oliver,0,0,0,,Sen yeterince güçlü değilsin.
Dialogue: 0,0:03:01.87,0:03:04.37,Flashback,Oliver,0,0,0,,Bu yüzden senden kahramanın grubundan ayrılmanı isteyeceğiz.
Dialogue: 0,0:03:05.81,0:03:06.86,Flashback,Orhun,0,0,0,,Oliver...
Dialogue: 0,0:03:08.31,0:03:15.80,Flashback_Italics,Orhun,0,0,0,,Oliver ve benim sekiz yıl önce kurduğumuz parti, sadece birkaç yıl içinde S-Rank'a ulaştı.
Dialogue: 0,0:03:16.59,0:03:22.00,Flashback_Italics,Orhun,0,0,0,,Güney Büyük Zindan'ın 94. katına ilk ulaşan biz olduk.
Dialogue: 0,0:03:22.00,0:03:26.02,Flashback_Italics,Orhun,0,0,0,,İnsanlar bize “Kahramanlar Partisi” demeye başladı.
Dialogue: 0,0:03:26.85,0:03:30.83,Flashback_Italics,Orhun,0,0,0,,Belki de haklısın. \N Belki de yeterince güçlü değilim.
Dialogue: 0,0:03:30.83,0:03:34.61,Flashback_Italics,Orhun,0,0,0,,Ama bu hepimiz için geçerli. Bu hızla gidersek...
Dialogue: 0,0:03:34.61,0:03:38.82,Flashback,Oliver,0,0,0,,Orhun, bunun ne kadar önemli olduğunu anlamadık.
Dialogue: 0,0:03:38.82,0:03:41.92,Flashback,Oliver,0,0,0,,destek büyüsü kullanabilen bir \Nbüyücüye sahip olmak.
Dialogue: 0,0:03:42.06,0:03:43.11,Flashback,Oliver,0,0,0,,Ama...
Dialogue: 0,0:03:43.67,0:03:45.64,Flashback,Oliver,0,0,0,,Geçen ay yapılan ortak baskında,
Dialogue: 0,0:03:45.64,0:03:50.75,Flashback,Oliver,0,0,0,,Diğer S-Rank partisinin büyücülerin ne kadar inanılmaz olduğunu görebildik.
Dialogue: 0,0:03:50.75,0:03:55.05,Flashback,Oliver,0,0,0,,Ve destek büyülerinin ne kadar\N zayıf olduğunu anladık.
Dialogue: 0,0:03:55.75,0:03:59.85,Flashback,Orhun,0,0,0,,Tabii ki öyle. Ben bir kılıç ustası olmalıyım.
Dialogue: 0,0:03:59.85,0:04:01.85,Flashback,Orhun,0,0,0,,Bu yüzden kendi özgün büyümü yarattım.
Dialogue: 0,0:04:01.85,0:04:03.01,Flashback,Derick,0,0,0,,Kapa çeneni!
Dialogue: 0,0:04:03.01,0:04:07.64,Flashback,Derick,0,0,0,,Oliver senden daha iyi kılıç kullanıyordu diye din değiştirdin!
Dialogue: 0,0:04:07.64,0:04:11.52,Flashback,Anneli,0,0,0,,Ve şimdi, sen de pek iyi bir büyücü değilsin.
Dialogue: 0,0:04:11.52,0:04:13.14,Flashback,Anneli,0,0,0,,Şikayet etme Durumununda mısınız?
Dialogue: 0,0:04:13.56,0:04:16.31,Flashback,Orhun,0,0,0,,Bir büyücüye ihtiyacımız vardı,
Dialogue: 0,0:04:16.31,0:04:20.31,Flashback,Orhun,0,0,0,,Bu yüzden ben dönüştüm, çünkü bu konuda en yetenekli olan bendim.
Dialogue: 0,0:04:20.31,0:04:23.57,Flashback,Orhun,0,0,0,,Kusurlarımı telafi etmek için kendi türümde bir \N sihir icat ettim.
Dialogue: 0,0:04:23.57,0:04:26.74,Flashback,Orhun,0,0,0,,Ve bu sayede zindanın en derin katlarında bile hayatta kalabildik...
Dialogue: 0,0:04:26.74,0:04:29.29,Flashback,Oliver,0,0,0,,Zaten bir \N yedek büyücü bulduk.
Dialogue: 0,0:04:32.40,0:04:34.29,Flashback,Oliver,0,0,0,,Üzgünüm, ama durum böyle olacak.
Dialogue: 0,0:04:36.29,0:04:38.88,Flashback,Anneli,0,0,0,,Biz Kahramanların Partisiyiz!
Dialogue: 0,0:04:38.88,0:04:41.82,Flashback,Anneli,0,0,0,,Devam etmeliyiz!
Dialogue: 0,0:04:41.82,0:04:44.55,Flashback,Anneli,0,0,0,,Ve bunu sizinle yapamayız, \N demek istediğimiz budur.
Dialogue: 0,0:04:45.05,0:04:46.60,Flashback,Orhun,0,0,0,,Ne?
Dialogue: 0,0:04:47.81,0:04:51.63,Flashback,Orhun,0,0,0,,Birlikte yaşadığımız onca şeyden sonra bana böyle mi davranıyorsun?
Dialogue: 0,0:04:53.58,0:04:55.65,Flashback,Orhun,0,0,0,,Artık benim için burada bir yer yok, değil mi?
Dialogue: 0,0:04:58.21,0:05:01.07,Flashback,Orhun,0,0,0,,Çok iyi. Her şey için teşekkürler.
Dialogue: 0,0:05:06.32,0:05:10.70,Flashback,Anneli,0,0,0,,{\pos(584,240)}ÇVM: İlerde içinizden geçsin görcem ben sizi Sinir Ettiniz Beni
Dialogue: 0,0:05:06.32,0:05:10.70,Flashback,Anneli,0,0,0,,Büyü, kılıç dövüşü... pek çok şey yapabilirsin, \N ama sadece A-Rank seviyesinde.
Dialogue: 0,0:05:10.70,0:05:13.08,Flashback,Anneli,0,0,0,,Ama bize ne yapmamız gerektiğini söyleyip durdun,
Dialogue: 0,0:05:13.08,0:05:14.78,Flashback,Anneli,0,0,0,,ve bu bizi çok Kızdırıyordu.
Dialogue: 0,0:05:16.82,0:05:20.13,Flashback,Anneli,0,0,0,,Senin gibi insanlara ne dediklerini biliyor musun?
Dialogue: 0,0:05:20.13,0:05:22.59,Flashback,Anneli,0,0,0,,Her işi yapan adam!
Dialogue: 0,0:05:25.83,0:05:27.98,Main,Orhun,0,0,0,,Her işi yapan biri, ha?
Dialogue: 0,0:05:29.11,0:05:32.80,Main,Orhun,0,0,0,,Tamam. Bir kılıç ustası ve bir büyücü....
Dialogue: 0,0:05:32.80,0:05:35.92,Main,Orhun,0,0,0,,Geliştirdiğim bu yeni stil, ikisini birleştiriyor...
Dialogue: 0,0:05:36.56,0:05:38.52,Main,Orhun,0,0,0,,Bunu başaracak kadar uyumluyum.
Dialogue: 0,0:05:39.39,0:05:43.78,Italics,Orhun,0,0,0,,Artık kimse bana “her işi yapan adam” demeyecek...
Dialogue: 0,0:05:44.83,0:05:48.83,Main,Orhun,0,0,0,,Bir gün, her şeyi yapabilen bir maceracı olacağım.
Dialogue: 0,0:05:55.09,0:05:58.04,Main,Orhun,0,0,0,,Ve şimdi \N teleportasyon kristali ile kayıt oldum.
Dialogue: 0,0:05:58.69,0:06:02.08,Main,Orhun,0,0,0,,Bir dahaki sefere 7. kattan başlayabilirim.
Dialogue: 0,0:06:02.08,0:06:03.13,Main,Orhun,0,0,0,,Bugünlük bu kadar yeter...
Dialogue: 0,0:06:03.13,0:06:04.60,Main,Adventurer 1,0,0,0,,Çabuk! Hadi!
Dialogue: 0,0:06:07.90,0:06:08.95,Italics,Orhun,0,0,0,,Ne?
Dialogue: 0,0:06:13.06,0:06:15.53,Main,Adventurer 2,0,0,0,,Kahretsin! Bu nasıl oldu?
Dialogue: 0,0:06:15.53,0:06:18.52,Main,Adventurer 1,0,0,0,,Bu konuda yapabileceğimiz hiçbir şey yok. \N Çok fazla ork var...
Dialogue: 0,0:06:18.52,0:06:21.36,Main,Adventurer 2,0,0,0,,Ama o kızı geride bıraktık!
Dialogue: 0,0:06:21.36,0:06:22.19,Italics,Orhun,0,0,0,,Ne?
Dialogue: 0,0:06:22.19,0:06:24.32,Main,Adventurer 1,0,0,0,,Yok edilirdik!
Dialogue: 0,0:06:25.13,0:06:27.45,Main,Adventurer 1,0,0,0,,Doğru kararı verdim!
Dialogue: 0,0:06:27.45,0:06:29.20,Main,Adventurer 2,0,0,0,,A-Ama bu demek olamaz ki...
Dialogue: 0,0:06:29.88,0:06:32.25,Main,Adventurer 1,0,0,0,,O bugün aramıza katıldı...
Dialogue: 0,0:06:32.25,0:06:35.20,Main,Adventurer 1,0,0,0,,Tabii ki size öncelik vereceğim, eski dostlarım!
Dialogue: 0,0:06:35.65,0:06:37.65,Italics,Orhun,0,0,0,,Bu işe karışmamalıyım.
Dialogue: 0,0:06:38.17,0:06:41.82,Italics,Orhun,0,0,0,,Onlara katılarak sadece şanssızlık yaşadı, hepsi bu.
Dialogue: 0,0:06:42.16,0:06:43.21,Italics,Orhun,0,0,0,,Ama
Dialogue: 0,0:06:44.31,0:06:48.97,Italics,Orhun,0,0,0,,Partinin seni terk etmesinin ne kadar acı verici olduğunu biliyorum.
Dialogue: 0,0:06:49.41,0:06:51.21,Main,Adventurer 1,0,0,0,,Doğru kararı verdim!
Dialogue: 0,0:06:51.21,0:06:53.78,Main,Adventurer 1,0,0,0,,Beğenmediysen, onu kurtarmaya gidecek misin?
Dialogue: 0,0:06:53.78,0:06:56.29,Main,Adventurer 2,0,0,0,,Olmaz! Yapamam...
Dialogue: 0,0:06:56.29,0:06:57.89,Main,Orhun,0,0,0,,Bunu dinlemeye dayanamıyorum.
Dialogue: 0,0:06:58.44,0:06:59.90,Main,Adventurer 2,0,0,0,,Kimsin sen?
Dialogue: 0,0:07:01.47,0:07:03.59,Main,Orhun,0,0,0,,{\pos(616,300)}ÇVM: Orhun karışma olm sanane aq
Dialogue: 0,0:07:01.47,0:07:03.59,Main,Orhun,0,0,0,,O kızı ölüme terk ettin.
Dialogue: 0,0:07:03.59,0:07:06.66,Main,Orhun,0,0,0,,Şimdi onu kurtarmak yerine sadece bahaneler uyduruyorsun.
Dialogue: 0,0:07:06.66,0:07:08.99,Main,Orhun,0,0,0,,Senin gibi adamlar beni her şeyden daha çok sinirlendiriyor.
Dialogue: 0,0:07:08.99,0:07:11.20,Main,Adventurer 2,0,0,0,,Sen... Bu ne cüret?!
Dialogue: 0,0:07:11.20,0:07:15.24,Main,Adventurer 2,0,0,0,,Orada kalsam bile, \N onu tek başıma kurtaramazdım!
Dialogue: 0,0:07:18.83,0:07:20.65,Main,Orhun,0,0,0,,O zaman öylece yat.
Dialogue: 0,0:07:20.65,0:07:21.70,Main,Orhun,0,0,0,,O nerede?
Dialogue: 0,0:07:22.38,0:07:24.78,Main,Orhun,0,0,0,,Onu nerede ölüme terk ettiğini söyle!
Dialogue: 0,0:07:28.32,0:07:29.38,Main,Sophia,0,0,0,,Uzak dur...
Dialogue: 0,0:07:35.16,0:07:36.28,Main,Sophia,0,0,0,,Uzak dur...
Dialogue: 0,0:07:37.01,0:07:38.64,Main,Sophia,0,0,0,,Benden uzak dur!
Dialogue: 0,0:07:43.65,0:07:46.62,Main,Sophia,0,0,0,,Bu kadar çok şeyle başa çıkamıyorum...
Dialogue: 0,0:07:47.47,0:07:48.65,Main,Sophia,0,0,0,,Kardeşim...!
Dialogue: 0,0:07:54.37,0:07:55.50,Main,Sophia,0,0,0,,Birisi...
Dialogue: 0,0:07:56.53,0:07:57.58,Main,Sophia,0,0,0,,kurtarsın beni!
Dialogue: 0,0:08:00.77,0:08:02.16,Main,Orhun,0,0,0,,Aeroshock!
Dialogue: 0,0:08:14.90,0:08:16.95,Italics,Sophia,0,0,0,,O kim? Bir kılıç ustası mı?
Dialogue: 0,0:08:19.33,0:08:21.06,Main,Orhun,0,0,0,,Güçlen!
Dialogue: 0,0:08:26.37,0:08:27.71,Main,Orhun,0,0,0,,Teknik olarak hazır!
Dialogue: 0,0:08:29.76,0:08:31.15,Main,Sophia,0,0,0,,Büyü desteği mi?
Dialogue: 0,0:08:38.36,0:08:41.25,Italics,Sophia,0,0,0,,O bir kılıç ustası mı? Yoksa bir büyücü mü?
Dialogue: 0,0:08:45.30,0:08:46.89,Main,Orhun,0,0,0,,Keskinlik Artışı!
Dialogue: 0,0:08:57.91,0:09:02.43,Italics,Sophia,0,0,0,,Vay canına... Hiç kimseyi böyle dövüşürken görmemiştim!
Dialogue: 0,0:09:05.94,0:09:07.97,Italics,Orhun,0,0,0,,Onlardan çok var.
Dialogue: 0,0:09:07.97,0:09:10.87,Italics,Orhun,0,0,0,,Düşük rütbeli bir partinin neden aday olacağını anlayabiliyorum.
Dialogue: 0,0:09:11.46,0:09:13.24,Italics,Orhun,0,0,0,,Ama ben...
Dialogue: 0,0:09:16.38,0:09:18.03,Italics,Orhun,0,0,0,,Bunu tek başıma halledebilirim!
Dialogue: 0,0:09:20.01,0:09:21.16,Italics,Sophia,0,0,0,,O...
Dialogue: 0,0:09:28.00,0:09:29.60,Italics,Sophia,0,0,0,,çok güçlü!
Dialogue: 0,0:09:34.96,0:09:36.01,Main,Orhun,0,0,0,,İyi misin?
Dialogue: 0,0:09:38.02,0:09:40.86,Main,Sophia,0,0,0,,Ben Hayattayım...
Dialogue: 0,0:09:55.01,0:09:57.07,Main,Orhun,0,0,0,,Tamam, ben gidiyorum.
Dialogue: 0,0:09:57.07,0:09:59.00,Main,Sophia,0,0,0,,Bekle!
Dialogue: 0,0:10:00.96,0:10:03.68,Main,Sophia,0,0,0,,Size düzgün bir şekilde teşekkür edeyim.
Dialogue: 0,0:10:04.19,0:10:05.89,Main,Sophia,0,0,0,,Çok teşekkür ederim!
Dialogue: 0,0:10:06.63,0:10:09.21,Main,Sophia,0,0,0,,Benim adım Sophia Claudel!
Dialogue: 0,0:10:10.03,0:10:11.24,Main,Orhun,0,0,0,,Claudel?
Dialogue: 0,0:10:12.11,0:10:13.47,Italics,Orhun,0,0,0,,O arma...
Dialogue: 0,0:10:13.47,0:10:14.21,Main,Sophia,0,0,0,,Um...
Dialogue: 0,0:10:14.21,0:10:18.80,Main,Orhun,0,0,0,,Oh, hayır, adımı söylemediğim için özür dilerim.
Dialogue: 0,0:10:18.80,0:10:19.97,Main,Orhun,0,0,0,,Ben Orhun Dura.
Dialogue: 0,0:10:20.42,0:10:22.08,Main,Sophia,0,0,0,,Orhun...
Dialogue: 0,0:10:22.08,0:10:23.85,Main,Sophia,0,0,0,,Harika bir isim.
Dialogue: 0,0:10:26.00,0:10:32.61,Main,Sophia,0,0,0,,Peki, Orhun... teşekkür etmek için sana akşam yemeği ısmarlayabilir miyim?
Dialogue: 0,0:10:33.14,0:10:36.24,Main,Orhun,0,0,0,,Teşekkür etmek istediğim için seni kurtarmadım...
Dialogue: 0,0:10:36.63,0:10:38.06,Main,Sophia,0,0,0,,Lütfen!
Dialogue: 0,0:10:40.38,0:10:42.24,Main,Orhun,0,0,0,,T-Tamam
Dialogue: 0,0:10:42.24,0:10:44.24,Main,Sophia,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:10:47.12,0:10:49.12,Main,Sophia,0,0,0,,Orhun, geldik!
Dialogue: 0,0:10:51.54,0:10:56.01,Main,Sophia,0,0,0,,Burası pahalı değil, \N ama gerçekten çok iyi!
Dialogue: 0,0:10:56.32,0:10:58.44,Italics,Orhun,0,0,0,,Düşündüğüm gibi, \N bu da Tavşanlar'ın dükkanlarından biri...
Dialogue: 0,0:11:00.82,0:11:03.64,Italics,Orhun,0,0,0,,Pelerinindeki armadan tahmin edebiliyordum,
Dialogue: 0,0:11:03.64,0:11:07.78,Italics,Orhun,0,0,0,,ama o açıkça \N Night Sky Silver Rabbits'ten,
Dialogue: 0,0:11:07.78,0:11:11.60,Italics,Orhun,0,0,0,,Nohitant krallığındaki en büyük loncalardan biri.
Dialogue: 0,0:11:11.96,0:11:16.61,Italics,Orhun,0,0,0,,Gece Gökyüzü Gümüş Tavşanlar, krallığın en popüler klanlarından biridir...
Dialogue: 0,0:11:16.96,0:11:19.18,Italics,Orhun,0,0,0,,Sonuçta, o da onların bir parçası.
Dialogue: 0,0:11:20.11,0:11:21.72,Main,Sophia,0,0,0,,Kardeşim?
Dialogue: 0,0:11:22.52,0:11:23.98,Main,Sophia,0,0,0,,Burada ne yapıyorsun?
Dialogue: 0,0:11:24.69,0:11:25.74,Italics,Orhun,0,0,0,,Kardeşim?
Dialogue: 0,0:11:25.74,0:11:27.49,Main,Selma,0,0,0,,Oh, Sophia?
Dialogue: 0,0:11:27.82,0:11:30.42,Main,Selma,0,0,0,,Bugün bu civarda bir toplantım vardı.
Dialogue: 0,0:11:31.00,0:11:33.70,Main,Selma,0,0,0,,Peki... kiminle birliktesin?
Dialogue: 0,0:11:33.70,0:11:36.94,Main,Selma,0,0,0,,Henüz erkek arkadaş edinmek için çok erkensin!
Dialogue: 0,0:11:38.81,0:11:40.22,Main,Selma,0,0,0,,Orhun Dura?
Dialogue: 0,0:11:40.67,0:11:44.18,Main,Orhun,0,0,0,,Uzun zaman oldu, Selma Claudel...
Dialogue: 0,0:11:45.04,0:11:48.18,Main,Sophia,0,0,0,,Orhun, onu tanıyor musun?
Dialogue: 0,0:11:48.18,0:11:49.68,Main,Orhun,0,0,0,,Evet, tabii ki.
Dialogue: 0,0:11:50.54,0:11:56.32,Italics,Orhun,0,0,0,,Selma Claudel, Silver Rabbits'in en güçlü grubu olan S-Rank grubunun lideridir...
Dialogue: 0,0:11:56.32,0:11:59.44,Italics,Orhun,0,0,0,,ve kıtanın en güçlü büyücüsü.
Dialogue: 0,0:12:00.16,0:12:03.96,Italics,Orhun,0,0,0,,Büyücüleri ünlü yapan kişi odur.
Dialogue: 0,0:12:03.96,0:12:07.70,Italics,Orhun,0,0,0,,ve farklı \N parti üyelerinin farklı rollere sahip olması fikrini ortaya attı.
Dialogue: 0,0:12:07.70,0:12:09.83,Italics,Orhun,0,0,0,,Saldırganlar düşmanı alt etmek için.
Dialogue: 0,0:12:09.83,0:12:11.58,Italics,Orhun,0,0,0,,Darbelerden korunmak için savunmacılar.
Dialogue: 0,0:12:11.58,0:12:13.71,Italics,Orhun,0,0,0,,Arka planda yardım eden destekçiler.
Dialogue: 0,0:12:13.71,0:12:17.18,Italics,Orhun,0,0,0,,Partiyi bu üç role ayırmak onun fikriydi.
Dialogue: 0,0:12:17.72,0:12:21.10,Italics,Orhun,0,0,0,,Bu, maceracıların zindanlara girme konusundaki düşüncelerini sonsuza dek değiştirdi.
Dialogue: 0,0:12:22.49,0:12:24.85,Italics,Orhun,0,0,0,,Kahramanların Partisi de bir istisna değildir.
Dialogue: 0,0:12:24.85,0:12:27.95,Italics,Orhun,0,0,0,,Bu yüzden kılıç ustasından büyücüye dönüşmek zorunda kaldım.
Dialogue: 0,0:12:28.97,0:12:34.37,Italics,Orhun,0,0,0,,Ve geçen ayki baskında onu görmek,
Dialogue: 0,0:12:34.37,0:12:36.65,Italics,Orhun,0,0,0,,Oliver ve diğerleri benden kurtulmak için.
Dialogue: 0,0:12:38.02,0:12:40.63,Italics,Orhun,0,0,0,,Onların sadece aynı klandan olduklarını sanıyordum...
Dialogue: 0,0:12:40.63,0:12:42.67,Italics,Orhun,0,0,0,,Onların kardeş olacağını beklemiyordum.
Dialogue: 0,0:12:43.74,0:12:47.93,Italics,Orhun,0,0,0,,Ama... Neden bana kızgın?
Dialogue: 0,0:12:47.93,0:12:52.12,Main,Selma,0,0,0,,Yani benim on dört yaşındaki kız\Nkardeşimin peşindesin?
Dialogue: 0,0:12:52.12,0:12:54.62,Main,Selma,0,0,0,,Bu çok cesurca bir davranış.
Dialogue: 0,0:12:55.04,0:12:58.13,Italics,Orhun,0,0,0,,Oh, demek öyle.
Dialogue: 0,0:12:58.13,0:12:59.57,Main,Orhun,0,0,0,,Her şeyi yanlış anlamışsın.
Dialogue: 0,0:12:59.57,0:13:02.14,Main,Orhun,0,0,0,,Evet, onunla akşam yemeği yiyecektim.
Dialogue: 0,0:13:02.14,0:13:04.38,Main,Orhun,0,0,0,,Ama niyetim tamamen saf, sizi temin ederim.
Dialogue: 0,0:13:04.38,0:13:08.53,Main,Selma,0,0,0,,{\pos(572,156)}ÇVM: Salak Öyle demek istemedi
Dialogue: 0,0:13:04.38,0:13:08.53,Main,Selma,0,0,0,,Ne, yani benim Sophia'm sana yetmiyor mu?
Dialogue: 0,0:13:08.53,0:13:10.14,Italics,Orhun,0,0,0,,Vay canına, bu çok sinir bozucu.
Dialogue: 0,0:13:10.14,0:13:12.27,Main,Sophia,0,0,0,,Abla! Dur!
Dialogue: 0,0:13:12.27,0:13:15.39,Main,Sophia,0,0,0,,Hayatımı kurtaran adama kaba davranma!
Dialogue: 0,0:13:16.05,0:13:17.89,Main,Selma,0,0,0,,Hayatını kurtardı mı?
Dialogue: 0,0:13:18.32,0:13:19.45,Main,Selma,0,0,0,,Sakın söyleme...
Dialogue: 0,0:13:20.45,0:13:22.68,Main,Selma,0,0,0,,Zindana tek başına mı gittin?
Dialogue: 0,0:13:23.10,0:13:24.15,Main,Sophia,0,0,0,,Um...
Dialogue: 0,0:13:25.11,0:13:26.53,Main,Selma,0,0,0,,Öyle mi?
Dialogue: 0,0:13:27.81,0:13:28.86,Main,Sophia,0,0,0,,Evet
Dialogue: 0,0:13:31.72,0:13:35.48,Main,Selma,0,0,0,,Sana yarın öbür gün Büyük Zindan'a gideceğimizi söylemiştim.
Dialogue: 0,0:13:35.48,0:13:38.29,Main,Selma,0,0,0,,ve birkaç gün kalmak için...
Dialogue: 0,0:13:38.74,0:13:40.42,Main,Sophia,0,0,0,,Özür dilerim.
Dialogue: 0,0:13:40.42,0:13:44.80,Italics,Orhun,0,0,0,,Anlıyorum. Yani klanına haber vermeden zindan keşfi yapıyormuş.
Dialogue: 0,0:13:44.80,0:13:48.95,Main,Selma,0,0,0,,Görünüşe göre güvendesin, bu yüzden sana bu konuda zorluk çıkarmayacağım.
Dialogue: 0,0:13:48.95,0:13:51.47,Main,Selma,0,0,0,,Ama bundan sonra, tek başına dışarı çıkmak yok.
Dialogue: 0,0:13:51.47,0:13:52.31,Main,Sophia,0,0,0,,Tamam
Dialogue: 0,0:13:52.83,0:13:56.64,Main,Selma,0,0,0,,Orhun, sanırım kız kardeşimi kurtardın. \NTeşekkür ederim.
Dialogue: 0,0:13:57.13,0:14:00.81,Main,Selma,0,0,0,,Kaba davrandığım için özür dilerim.
Dialogue: 0,0:14:00.81,0:14:02.71,Main,Orhun,0,0,0,,Sorun yok.
Dialogue: 0,0:14:04.65,0:14:06.70,Main,Selma,0,0,0,,Baskından beri seni görmedim.
Dialogue: 0,0:14:07.12,0:14:08.41,Main,Orhun,0,0,0,,Doğru.
Dialogue: 0,0:14:08.41,0:14:11.13,Main,Selma,0,0,0,,Bu şekilde konuşmak bizim için ilk kez oluyor.
Dialogue: 0,0:14:11.13,0:14:11.83,Main,Orhun,0,0,0,,Evet
Dialogue: 0,0:14:12.16,0:14:15.04,Main,Sophia,0,0,0,,Siz ikiniz tanışıyor muydunuz?
Dialogue: 0,0:14:15.42,0:14:20.09,Main,Orhun,0,0,0,,Geçen ay yapılan baskında tanıştık.
Dialogue: 0,0:14:20.09,0:14:21.67,Main,Sophia,0,0,0,,Anlıyorum.
Dialogue: 0,0:14:23.52,0:14:27.93,Main,Selma,0,0,0,,İkimiz de büyücüyüz, bu yüzden\N birlikte görevlendirildik.
Dialogue: 0,0:14:28.24,0:14:32.93,Main,Orhun,0,0,0,,Sen komutayı aldın, ben de sana yardım ettim.
Dialogue: 0,0:14:33.29,0:14:37.88,Main,Selma,0,0,0,,Ve çok yardımcı oldun. \N Tam da beklediğim gibiydi.
Dialogue: 0,0:14:37.88,0:14:41.44,Main,Sophia,0,0,0,,Sanki onu uzun zamandır tanıyormuşsun gibi.
Dialogue: 0,0:14:42.44,0:14:45.69,Main,Selma,0,0,0,,Ne, Sophia? Orhun'u bilmiyor musun?
Dialogue: 0,0:14:46.73,0:14:49.45,Main,Sophia,0,0,0,,Hayır. Ünlü mü?
Dialogue: 0,0:14:49.73,0:14:54.35,Main,Selma,0,0,0,,Tabii ki öyle! O, Kahramanlar Partisi'nin bir üyesi!
Dialogue: 0,0:14:58.21,0:15:00.12,Main,Sophia,0,0,0,,Şey, şey...
Dialogue: 0,0:15:00.12,0:15:01.71,Main,Orhun,0,0,0,,Bu kadar telaşlanma.
Dialogue: 0,0:15:02.31,0:15:05.71,Main,Orhun,0,0,0,,Ve artık bir kahraman değilim.
Dialogue: 0,0:15:06.00,0:15:09.47,Main,Selma,0,0,0,,Değil misin? Partinden ayrıldın mı?
Dialogue: 0,0:15:09.99,0:15:12.68,Main,Orhun,0,0,0,,Evet. Dün.
Dialogue: 0,0:15:12.68,0:15:15.22,Main,Selma,0,0,0,,Neden senin gibi birini bırakacaklar ki?
Dialogue: 0,0:15:15.94,0:15:17.83,Main,Orhun,0,0,0,,Eh, onların da sebepleri vardı.
Dialogue: 0,0:15:17.83,0:15:19.91,Main,Orhun,0,0,0,,İkimiz de bunu kabul ettik.
Dialogue: 0,0:15:20.61,0:15:21.85,Main,Selma,0,0,0,,Anlıyorum...
Dialogue: 0,0:15:23.76,0:15:26.76,Main,Selma,0,0,0,,Şu anda boşsun, değil mi?
Dialogue: 0,0:15:26.76,0:15:28.78,Main,Orhun,0,0,0,,Sanırım öyle.
Dialogue: 0,0:15:29.29,0:15:31.86,Italics,Orhun,0,0,0,,Beni Silver Rabbits'e üye yapacak mı?
Dialogue: 0,0:15:31.86,0:15:33.53,Main,Selma,0,0,0,,Eğer meşgul değilsen...
Dialogue: 0,0:15:33.53,0:15:34.37,Main,Orhun,0,0,0,,Üzgünüm!
Dialogue: 0,0:15:35.24,0:15:40.37,Main,Orhun,0,0,0,,Şey, bir süreliğine klan veya partiye katılmak istemiyorum...
Dialogue: 0,0:15:40.72,0:15:42.99,Main,Selma,0,0,0,,Sanırım yanlış anladınız.
Dialogue: 0,0:15:45.12,0:15:47.59,Main,Selma,0,0,0,,Senin için mükemmel bir işim var.
Dialogue: 0,0:15:47.89,0:15:49.03,Main,Orhun,0,0,0,,Job?
Dialogue: 0,0:15:49.47,0:15:54.63,Main,Selma,0,0,0,,Yarın klanımızla birlikte öğretim gezisine katılmanı istiyorum.
Dialogue: 0,0:15:54.63,0:15:56.10,Main,Selma,0,0,0,,Ödemenizi alacağından emin olacağım.
Dialogue: 0,0:15:56.67,0:15:58.52,Main,Orhun,0,0,0,,Öğretim gezisi mi?
Dialogue: 0,0:15:58.80,0:16:02.13,Main,Selma,0,0,0,,Adından da anlaşılacağı gibi. Yeni işe alınanlara öğretmek için.
Dialogue: 0,0:16:02.13,0:16:04.61,Main,Selma,0,0,0,,Bunu işbaşı eğitimi olarak düşünebilirsiniz.
Dialogue: 0,0:16:05.08,0:16:08.26,Main,Orhun,0,0,0,,Benim de gelmemi mi istiyorsun?
Dialogue: 0,0:16:08.26,0:16:12.56,Main,Selma,0,0,0,,A-Rank ve üstü bir grup \N yeni askerleri yönetecek.
Dialogue: 0,0:16:12.56,0:16:16.62,Main,Selma,0,0,0,,Güney Büyük Zindan'da 50 kat aşağı inerek üç gün geçireceğiz.
Dialogue: 0,0:16:16.94,0:16:18.33,Main,Orhun,0,0,0,,Üç gün mü?
Dialogue: 0,0:16:18.33,0:16:23.04,Main,Orhun,0,0,0,,En iyi yeni maceracılar bile \N altı aydan bir yıla kadar sürerdi.
Dialogue: 0,0:16:23.04,0:16:24.88,Main,Orhun,0,0,0,,Bu oldukça çılgın bir program.
Dialogue: 0,0:16:25.36,0:16:29.77,Main,Selma,0,0,0,,Çılgınca, ama imkansız değil \N en kısa yolu seçersen.
Dialogue: 0,0:16:29.77,0:16:30.86,Main,Orhun,0,0,0,,Ama?
Dialogue: 0,0:16:31.34,0:16:34.13,Main,Selma,0,0,0,,Ve sponsorlarımız ısrar ediyor...
Dialogue: 0,0:16:34.78,0:16:38.19,Main,Orhun,0,0,0,,Gümüş Tavşanlar \N zor günler geçiriyorlar galiba, ha?
Dialogue: 0,0:16:38.94,0:16:41.61,Main,Orhun,0,0,0,,Ama senin önerdiğin şey \N o kadar çılgınca ki
Dialogue: 0,0:16:41.61,0:16:44.72,Main,Orhun,0,0,0,,sponsorlarınızı reddedebilmeliydiniz.
Dialogue: 0,0:16:45.19,0:16:47.65,Main,Orhun,0,0,0,,Zaten yapıyorsan...
Dialogue: 0,0:16:48.65,0:16:50.41,Main,Orhun,0,0,0,,Başka bir neden mi var?
Dialogue: 0,0:16:52.43,0:16:55.50,Main,Orhun,0,0,0,,Eğer yeni işe alınanlar kat patronunu yenemeyecekse
Dialogue: 0,0:16:55.50,0:16:57.97,Main,Orhun,0,0,0,,kendi başlarına daha derin katları keşfe çıkabilirler,
Dialogue: 0,0:16:57.97,0:17:00.79,Main,Orhun,0,0,0,,bu, klanı bir bütün olarak güçlendirecektir.
Dialogue: 0,0:17:03.12,0:17:07.12,Italics,Selma,0,0,0,,Sadece söylediğim birkaç şeyden mi anladı?
Dialogue: 0,0:17:07.12,0:17:09.80,Italics,Selma,0,0,0,,Düşündüğümden daha akıllıymış.
Dialogue: 0,0:17:10.42,0:17:13.95,Main,Selma,0,0,0,,Zindanlarda, kat patronlarını yenmeniz gerekiyor.
Dialogue: 0,0:17:13.95,0:17:16.32,Main,Selma,0,0,0,,her on katta bir daha derine inmek için görünür.
Dialogue: 0,0:17:16.32,0:17:19.56,Main,Selma,0,0,0,,Bu savaşlarda yeni askerlerin yaralanması veya ölmesi sık görülen bir durumdur.
Dialogue: 0,0:17:19.90,0:17:23.44,Main,Selma,0,0,0,,Ama deneyimli bir maceracı \N patronu alt edebilirse,
Dialogue: 0,0:17:23.44,0:17:29.66,Main,Selma,0,0,0,,daha sonra tek yapmaları gereken, bir sonraki kata geçmek için kristale kayıt yaptırmak.
Dialogue: 0,0:17:30.71,0:17:33.57,Main,Selma,0,0,0,,{\pos(492,336)}ÇVM: İhanet etmeyinde Orhuna
Dialogue: 0,0:17:30.71,0:17:33.57,Main,Selma,0,0,0,,Bu yüzden bizimle gelmeni istiyoruz.
Dialogue: 0,0:17:34.06,0:17:39.13,Main,Orhun,0,0,0,,Bu, Gümüş Tavşanlar için gerçekten önemli bir görev gibi görünüyor.
Dialogue: 0,0:17:39.13,0:17:40.83,Main,Orhun,0,0,0,,Benim gibi bir yabancı orada bulunabilir mi?
Dialogue: 0,0:17:41.18,0:17:42.23,Main,Selma,0,0,0,,Orhun.
Dialogue: 0,0:17:43.98,0:17:47.08,Main,Selma,0,0,0,,Sana saygı duyuyorum.
Dialogue: 0,0:17:48.88,0:17:52.85,Italics,Orhun,0,0,0,,Selma beni büyücü olarak mı görüyor?
Dialogue: 0,0:17:53.61,0:17:57.13,Italics,Orhun,0,0,0,,Dürüst olmak gerekirse, bu beni mutlu ediyor, ama neden öyle olsun ki?
Dialogue: 0,0:17:58.01,0:18:02.12,Italics,Orhun,0,0,0,,Çok zayıf olduğum için Kahramanlar Partisi'nden kovuldum.
Dialogue: 0,0:18:02.64,0:18:07.64,Italics,Orhun,0,0,0,,Çünkü baskın sırasında benim büyüm onunkinden daha kötüydü.
Dialogue: 0,0:18:08.47,0:18:11.43,Italics,Orhun,0,0,0,,Ve tekrar büyücü olmaya mı dönmeliyim?
Dialogue: 0,0:18:11.43,0:18:13.80,Italics,Orhun,0,0,0,,Bana olanlardan sonra mı?
Dialogue: 0,0:18:13.80,0:18:15.65,Italics,Orhun,0,0,0,,Tabii ki pişman olacağım.
Dialogue: 0,0:18:17.46,0:18:23.12,Main,Orhun,0,0,0,,Beni bu kadar takdir etmen beni mutlu ediyor, \N ama benim başka planlarım var.
Dialogue: 0,0:18:23.28,0:18:24.23,Main,Selma,0,0,0,,Orhun...
Dialogue: 0,0:18:24.23,0:18:30.50,Main,Sophia,0,0,0,,Şey, Orhun... Ben de gidiyorum.
Dialogue: 0,0:18:30.88,0:18:34.50,Main,Sophia,0,0,0,,Bu yüzden benimle gelirsen çok mutlu olurum!
Dialogue: 0,0:18:34.80,0:18:37.01,Main,Sophia,0,0,0,,Lütfen... lütfen!
Dialogue: 0,0:18:39.67,0:18:42.26,Main,Sophia,0,0,0,,Meşgul müsün...?
Dialogue: 0,0:18:44.56,0:18:46.77,Main,Orhun,0,0,0,,Bir düşüneyim.
Dialogue: 0,0:18:47.73,0:18:48.93,Main,Sophia,0,0,0,,Orhun.
Dialogue: 0,0:18:49.73,0:18:51.48,Main,Selma,0,0,0,,Tamam, anladım.
Dialogue: 0,0:18:51.92,0:18:57.00,Main,Orhun,0,0,0,,Açıkça belirtmek gerekirse, \N bir kılıç ustası olarak dönüştürdüm.
Dialogue: 0,0:18:57.00,0:18:58.11,Main,Selma,0,0,0,,Bir kılıç ustası mı?
Dialogue: 0,0:18:58.32,0:18:59.37,Main,Orhun,0,0,0,,Evet
Dialogue: 0,0:18:59.74,0:19:02.69,Main,Orhun,0,0,0,,Beni bir büyücü olarak saygı duyuyorsun gibi görünüyor.
Dialogue: 0,0:19:02.69,0:19:06.62,Main,Orhun,0,0,0,,Ama gideceksem, bir kılıç ustası olarak gideceğim.
Dialogue: 0,0:19:06.62,0:19:08.62,Main,Selma,0,0,0,,Neden bunu yaptın?
Dialogue: 0,0:19:09.01,0:19:11.01,Italics,Orhun,0,0,0,,Tabii ki şaşırmış.
Dialogue: 0,0:19:11.01,0:19:13.63,Italics,Orhun,0,0,0,,Ama bu, vazgeçmeyeceğim bir şey.
Dialogue: 0,0:19:14.62,0:19:17.13,Main,Selma,0,0,0,,Tamam, sorun değil.
Dialogue: 0,0:19:17.82,0:19:19.08,Italics,Selma,0,0,0,,Önemli değil.
Dialogue: 0,0:19:19.08,0:19:22.70,Italics,Selma,0,0,0,,İşler kötüye giderse, ana mesleği olan büyücüye geri dönecektir.
Dialogue: 0,0:19:24.28,0:19:29.39,Main,Selma,0,0,0,,Geliyorsanız, lütfen yarın sabah Silver\N Rabbit HQ'ya gelin.
Dialogue: 0,0:19:30.00,0:19:31.18,Main,Orhun,0,0,0,,Tamam.
Dialogue: 0,0:19:35.31,0:19:36.90,Main,Orhun,0,0,0,,İyi akşamlar.
Dialogue: 0,0:19:36.90,0:19:38.91,Main,Storekeeper,0,0,0,,Oh, Orhun?
Dialogue: 0,0:19:38.91,0:19:39.90,Main,Orhun,0,0,0,,Hala açık mısınız?
Dialogue: 0,0:19:40.28,0:19:42.88,Main,Storekeeper,0,0,0,,Kapatmak üzereydim.
Dialogue: 0,0:19:42.88,0:19:44.91,Main,Storekeeper,0,0,0,,Ama acele etme.
Dialogue: 0,0:19:50.77,0:19:53.17,Main,Storekeeper,0,0,0,,Bugün yine yoğun bir gündü.
Dialogue: 0,0:19:53.56,0:19:55.42,Main,Orhun,0,0,0,,İyi olmana sevindim.
Dialogue: 0,0:19:55.42,0:19:59.67,Main,Storekeeper,0,0,0,,En iyi maceracı olduktan sonra mağazayı tanıttığınız için teşekkür ederiz.
Dialogue: 0,0:20:00.79,0:20:04.13,Main,Storekeeper,0,0,0,,Gerçekten minnettarım.
Dialogue: 0,0:20:04.13,0:20:06.93,Main,Orhun,0,0,0,,Yaşlı adam, üzgünüm.
Dialogue: 0,0:20:07.27,0:20:08.42,Main,Storekeeper,0,0,0,,Orhun?
Dialogue: 0,0:20:08.42,0:20:12.83,Main,Orhun,0,0,0,,Artık Kahramanlar Partisi'nin üyesi değilim.
Dialogue: 0,0:20:13.37,0:20:16.44,Main,Orhun,0,0,0,,Artık sizin için \N reklamını yapamayacağım.
Dialogue: 0,0:20:16.98,0:20:20.34,Main,Orhun,0,0,0,,Artık kahraman olmadığım için, \N kimse söylediklerimi dinlemeyecek.
Dialogue: 0,0:20:21.19,0:20:24.26,Main,Storekeeper,0,0,0,,Sana minnettarım.
Dialogue: 0,0:20:24.26,0:20:26.45,Main,Storekeeper,0,0,0,,Her zaman öyle oldum ve her zaman öyle olacağım.
Dialogue: 0,0:20:26.45,0:20:30.83,Main,Storekeeper,0,0,0,,Sen hala sensin, kahraman olsan da olmasan da.
Dialogue: 0,0:20:30.83,0:20:35.58,Main,Storekeeper,0,0,0,,Tekrar söyleyeyim... teşekkür ederim.
Dialogue: 0,0:20:36.12,0:20:39.34,Main,Orhun,0,0,0,,Bana teşekkür eder miydin... benim gibi birine?
Dialogue: 0,0:20:39.34,0:20:41.45,Main,Storekeeper,0,0,0,,Bu garip mi?
Dialogue: 0,0:20:41.45,0:20:47.60,Main,Storekeeper,0,0,0,,Ne yaptığını, ne kadar çok çalıştığını herkesten daha iyi biliyorum.
Dialogue: 0,0:20:47.89,0:20:51.04,Main,Storekeeper,0,0,0,,Bundan sonra,
Dialogue: 0,0:20:51.04,0:20:56.23,Main,Storekeeper,0,0,0,,daha da fazla “teşekkür ederim” duyacaksınız.
Dialogue: 0,0:20:56.66,0:21:00.86,Main,Storekeeper,0,0,0,,Bu sözler, dışarıda sana ihtiyacı olan \N kişi olduğu anlamına gelir.
Dialogue: 0,0:21:01.40,0:21:04.48,Main,Storekeeper,0,0,0,,Bu sözleri her duyduğunda onlara değer ver.
Dialogue: 0,0:21:04.48,0:21:05.68,Main,Orhun,0,0,0,,Yaşlı adam...
Dialogue: 0,0:21:05.68,0:21:08.12,Main,Storekeeper,0,0,0,,İşler daha yeni başlıyor, Orhun.
Dialogue: 0,0:21:08.12,0:21:12.12,Main,Storekeeper,0,0,0,,En iyi olduğunu düşündüğün şeyi yap.
Dialogue: 0,0:21:12.60,0:21:16.88,Main,Storekeeper,0,0,0,,Kendin için yaşa. Başkalarına yardım et.
Dialogue: 0,0:21:17.14,0:21:20.80,Main,Storekeeper,0,0,0,,Ne olursa olsun, ben senin tarafındayım.
Dialogue: 0,0:21:21.29,0:21:23.66,Main,Orhun,0,0,0,,Teşekkürler, ihtiyar...
Dialogue: 0,0:21:40.32,0:21:42.78,Sign_Basic,Title,0,0,0,,{\an8}HER İŞİ YAPAN, HİÇBİR PARTİYE ÜYESİ OLMAYAN
Dialogue: 0,0:23:08.45,0:23:10.83,Main,Orhun,0,0,0,,Günaydın, Selma.
Dialogue: 0,0:23:11.81,0:23:13.08,Main,Selma,0,0,0,,Geldin, ha?
Dialogue: 0,0:23:14.00,0:23:15.28,Main,Selma,0,0,0,,Beni takip et.
Dialogue: 0,0:23:24.43,0:23:27.29,Main,Selma,0,0,0,,Dün olduğundan daha canlı görünüyorsun.
Dialogue: 0,0:23:27.29,0:23:30.47,Main,Selma,0,0,0,,Kahramanlar Grubu'ndan ayrıldığın için rahatlamış olmalısın.
Dialogue: 0,0:23:30.93,0:23:33.64,Main,Orhun,0,0,0,,Evet, öyle bir şey.
