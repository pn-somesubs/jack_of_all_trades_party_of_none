Dialogue: 0,0:00:09.41,0:00:10.24,Sign_Basic,Sign,0,0,0,,HER İŞİ YAPAN, HİÇBİR PARTİYE ÜYESİ OLMAYAN
Dialogue: 0,0:00:10.53,0:00:17.79,Sign_Basic,Sign,0,0,0,,HER İŞİ YAPAN, HİÇBİR PARTİYE ÜYESİ OLMAYAN
Dialogue: 0,0:01:29.98,0:01:34.95,Sign_Basic,Sign,0,0,0,,BÖLÜM 7: HER İŞİ YAPAN ADAM \N DUYGULARINI TAKİP EDER
Dialogue: 0,0:01:35.77,0:01:38.24,Main,Luna,0,0,0,,{\pos(104,102)}Çeviri:Hana\NSomeSubs
Dialogue: 0,0:01:35.77,0:01:38.24,Main,Luna,0,0,0,,Bu... bir ışınlanma ışığı!
Dialogue: 0,0:01:41.02,0:01:42.49,Main,Adventurers,0,0,0,,Hey, ne oldu?
Dialogue: 0,0:01:42.49,0:01:44.41,Main,Adventurers,0,0,0,,Aniden zindandan dışarı çıkarıldık!
Dialogue: 0,0:01:45.67,0:01:46.91,Main,Derick,0,0,0,,O nedir?
Dialogue: 0,0:01:47.29,0:01:48.63,Main,Luna,0,0,0,,Gidip bakalım.
Dialogue: 0,0:01:50.30,0:01:52.09,Main,Luna,0,0,0,,Affedersiniz! Geçiyorum!
Dialogue: 0,0:01:58.09,0:01:59.59,Main,Oliver,0,0,0,,Kara Ejderha...!
Dialogue: 0,0:01:59.59,0:02:00.72,Main,Luna,0,0,0,,Bekle!
Dialogue: 0,0:02:01.25,0:02:02.85,Main,Luna,0,0,0,,Bir sorun var.
Dialogue: 0,0:02:05.47,0:02:06.98,Main,Derick,0,0,0,,Ne?
Dialogue: 0,0:02:06.98,0:02:08.98,Main,Anneli,0,0,0,,Zaten yenildi!
Dialogue: 0,0:02:09.31,0:02:11.37,Main,Oliver,0,0,0,,Burada neler oluyor?
Dialogue: 0,0:02:11.37,0:02:12.98,Main,Luna,0,0,0,,Bu...
Dialogue: 0,0:02:13.23,0:02:14.48,Main,Luna,0,0,0,,Orhun!
Dialogue: 0,0:02:16.40,0:02:17.58,Main,Orhun,0,0,0,,Luna?
Dialogue: 0,0:02:27.81,0:02:30.16,Main,Luna,0,0,0,,Kara Ejderha ile savaştın mı?!
Dialogue: 0,0:02:30.16,0:02:31.63,Main,Luna,0,0,0,,İyileşmeye ihtiyacın var!
Dialogue: 0,0:02:34.65,0:02:35.74,Main,Luna,0,0,0,,Orhun?
Dialogue: 0,0:02:38.70,0:02:41.14,Main,Orhun,0,0,0,,Temizliği hallet...
Dialogue: 0,0:02:49.04,0:02:52.45,Italics,Luna,0,0,0,,Neden Orhun yaralı görünen tek kişi?
Dialogue: 0,0:02:54.11,0:02:55.15,Italics,Luna,0,0,0,,Sakın söyleme...
Dialogue: 0,0:02:55.62,0:02:57.78,Italics,Luna,0,0,0,,Kendisi mi savaştı?
Dialogue: 0,0:02:58.13,0:03:00.34,Main,Derick,0,0,0,,Yendin mi?
Dialogue: 0,0:03:00.34,0:03:02.28,Main,Derick,0,0,0,,Bu imkansız! Neler oluyor?
Dialogue: 0,0:03:02.88,0:03:03.97,Main,Derick,0,0,0,,Beni görmezden gelmeye cüret etme!
Dialogue: 0,0:03:03.97,0:03:04.83,Main,Luna,0,0,0,,Yeter!
Dialogue: 0,0:03:04.83,0:03:06.00,Main,Derick,0,0,0,,Ne?!
Dialogue: 0,0:03:06.00,0:03:09.46,Main,Luna,0,0,0,,Orhun'un Kara Ejderha'yı yenen kişi olduğu açıktır.
Dialogue: 0,0:03:09.93,0:03:13.46,Main,Luna,0,0,0,,Neden kendi zayıflığını kabul etmiyorsun?
Dialogue: 0,0:03:13.46,0:03:14.95,Main,Derick,0,0,0,,Ne?
Dialogue: 0,0:03:14.95,0:03:17.67,Main,Derick,0,0,0,,Bize her zaman ne yapmamız gerektiğini söylemeye çalışıyorsun!
Dialogue: 0,0:03:18.20,0:03:20.38,Main,Luna,0,0,0,,Pixie, ona iyi bak.
Dialogue: 0,0:03:24.93,0:03:28.18,Main,Derick,0,0,0,,B-Bedenim hareket etmiyor...
Dialogue: 0,0:03:29.97,0:03:31.44,Main,Luna,0,0,0,,Dövüş çoktan bitti.
Dialogue: 0,0:03:31.44,0:03:33.07,Main,Oliver,0,0,0,,Kesin şunu, ikiniz de.
Dialogue: 0,0:03:39.74,0:03:40.86,Italics,Oliver,0,0,0,,Kahretsin!
Dialogue: 0,0:03:44.53,0:03:50.35,Main,Sophia,0,0,0,,Keşif gezisi hakkındaki raporum sadece Orhun hakkında olacak!
Dialogue: 0,0:03:51.33,0:03:53.12,Main,Sophia,0,0,0,,Bana cesaret verdi,
Dialogue: 0,0:03:53.12,0:03:56.21,Main,Sophia,0,0,0,,ve ilk ileri düzey büyümü yapmama yardım etti.
Dialogue: 0,0:03:56.59,0:04:00.11,Main,Sophia,0,0,0,,Bana \N Paralel Yapı hakkında bilgi verdi...
Dialogue: 0,0:04:00.11,0:04:01.38,Main,Sophia,0,0,0,,Ve...
Dialogue: 0,0:04:02.02,0:04:04.93,Main,Sophia,0,0,0,,O, kötü şöhretli Kara Ejderha'yı tek başına yendi!
Dialogue: 0,0:04:05.76,0:04:08.31,Main,Sophia,0,0,0,,O benim hayatımı yine kurtardı...
Dialogue: 0,0:04:08.99,0:04:13.31,Main,Sophia,0,0,0,,Dövüşürken çok havalıydı.
Dialogue: 0,0:04:13.70,0:04:16.92,Main,Sophia,0,0,0,,O da her zaman çok nazik bir ifadeye sahiptir...
Dialogue: 0,0:04:16.92,0:04:19.79,Main,Sophia,0,0,0,,Buna boşluk mu diyorlar?
Dialogue: 0,0:04:21.12,0:04:22.32,Main,Selma,0,0,0,,Geri döndüm...
Dialogue: 0,0:04:23.28,0:04:26.51,Main,Sophia,0,0,0,,Abla, hoş geldin... eve...
Dialogue: 0,0:04:29.83,0:04:32.00,Italics,Sophia,0,0,0,,Yüzü berbat durumda.
Dialogue: 0,0:04:36.87,0:04:40.59,Italics,Sophia,0,0,0,,Onu bu kadar yorgun gördüğümden beri çok uzun zaman geçti.
Dialogue: 0,0:04:40.59,0:04:44.34,Main,Sophia,0,0,0,,En azından yatmadan önce duş al.
Dialogue: 0,0:04:45.45,0:04:46.84,Main,Selma,0,0,0,,Daha sonra...
Dialogue: 0,0:04:49.35,0:04:51.76,Main,Sophia,0,0,0,,O zaman birlikte hamama gidelim!
Dialogue: 0,0:04:56.10,0:04:59.12,Main,Sophia,0,0,0,,Yorgun olduğunda banyo yapman gerekiyor, değil mi?
Dialogue: 0,0:04:59.12,0:05:01.50,Main,Selma,0,0,0,,Teşekkürler, Sophia!
Dialogue: 0,0:05:02.99,0:05:06.74,Main,Selma,0,0,0,,Bugün güvende olduğun için çok mutluyum.
Dialogue: 0,0:05:07.12,0:05:09.20,Main,Sophia,0,0,0,,Bu, Orhun sayesinde oldu.
Dialogue: 0,0:05:09.20,0:05:11.74,Main,Sophia,0,0,0,,Bugün çok havalıydı, değil mi?
Dialogue: 0,0:05:12.48,0:05:14.24,Main,Selma,0,0,0,,Hey, Sophia.
Dialogue: 0,0:05:14.24,0:05:18.00,Main,Selma,0,0,0,,Orhun ile Kara Ejderha arasındaki dövüş sana nasıl geldi?
Dialogue: 0,0:05:18.36,0:05:22.01,Main,Sophia,0,0,0,,Ha? Şey, o gerçekten çok güçlüydü.
Dialogue: 0,0:05:22.01,0:05:24.38,Main,Selma,0,0,0,,Evet, bu normal bir tepki.
Dialogue: 0,0:05:24.72,0:05:28.91,Main,Selma,0,0,0,,O bizden o kadar güçlü ki, onu anlayamıyorum bile.
Dialogue: 0,0:05:28.91,0:05:30.51,Main,Sophia,0,0,0,,Onu anladım.
Dialogue: 0,0:05:30.51,0:05:31.49,Main,Selma,0,0,0,,Ne
Dialogue: 0,0:05:32.01,0:05:34.85,Main,Selma,0,0,0,,Ne anladığını söyle bana!
Dialogue: 0,0:05:34.85,0:05:37.82,Main,Sophia,0,0,0,,Sakin ol, Kardeşim
Dialogue: 0,0:05:40.80,0:05:42.02,Main,Selma,0,0,0,,Üzgünüm
Dialogue: 0,0:05:43.01,0:05:46.40,Main,Sophia,0,0,0,,Hareketleri ve büyüsü inanılmazdı.
Dialogue: 0,0:05:46.40,0:05:50.03,Main,Sophia,0,0,0,,ama bence geri kalanı sadece temel bilgilerdi.
Dialogue: 0,0:05:50.36,0:05:52.44,Main,Selma,0,0,0,,Temel bilgiler?
Dialogue: 0,0:05:52.44,0:05:53.16,Main,Sophia,0,0,0,,Evet.
Dialogue: 0,0:05:53.48,0:05:59.75,Main,Sophia,0,0,0,,Bu, bize arka saldırganların ve savunmacıların nasıl savaştığını öğrettiği şeyin tam olarak aynısıydı.
Dialogue: 0,0:06:00.00,0:06:02.92,Main,Sophia,0,0,0,,Bu yüzden çok şey öğrendim!
Dialogue: 0,0:06:02.92,0:06:07.38,Main,Sophia,0,0,0,,Bütün bunları tek başına yapabilmesi şaşırtıcı, değil mi?
Dialogue: 0,0:06:08.08,0:06:11.77,Italics,Selma,0,0,0,,Asla anlayamayacağımı düşünmüştüm
Dialogue: 0,0:06:11.77,0:06:15.39,Italics,Selma,0,0,0,,Orhun'un mücadelesinde gördüğüm, dipsiz bir güç kaynağı.
Dialogue: 0,0:06:15.39,0:06:17.47,Italics,Selma,0,0,0,,ama Sophia farklıydı.
Dialogue: 0,0:06:17.92,0:06:21.18,Italics,Selma,0,0,0,,Kendi tarzında gördüklerini anladı.
Dialogue: 0,0:06:22.10,0:06:24.26,Main,Selma,0,0,0,,Sen harikasın, Sophia.
Dialogue: 0,0:06:24.26,0:06:25.40,Main,Selma,0,0,0,,Ben değilim...
Dialogue: 0,0:06:28.80,0:06:30.40,Main,Sophia,0,0,0,,Bu doğru değil.
Dialogue: 0,0:06:30.40,0:06:32.41,Main,Sophia,0,0,0,,Sen çok daha harikasın, Ablacım!
Dialogue: 0,0:06:32.76,0:06:34.00,Main,Selma,0,0,0,,Sophia...
Dialogue: 0,0:06:34.00,0:06:37.66,Main,Sophia,0,0,0,,Sana herkesten Daha çok saygı duyuyorum.
Dialogue: 0,0:06:38.00,0:06:39.87,Main,Sophia,0,0,0,,Kendi ayakların üzerinde yürüyorsun.
Dialogue: 0,0:06:39.87,0:06:43.44,Main,Sophia,0,0,0,,Sen çok havalısın ve birçok insan sana güveniyor!
Dialogue: 0,0:06:43.44,0:06:46.95,Main,Sophia,0,0,0,,Senin gibi olmak istiyorum!
Dialogue: 0,0:06:49.89,0:06:53.82,Main,Sophia,0,0,0,,Ama kendini çok zorlama, abla!
Dialogue: 0,0:06:58.49,0:07:00.94,Main,Orhun,0,0,0,,Ow...
Dialogue: 0,0:07:02.15,0:07:04.00,Main,Orhun,0,0,0,,Ağrıyı dindirin!
Dialogue: 0,0:07:13.05,0:07:15.39,Main,Orhun,0,0,0,,Bütün vücudum ağrıyor...
Dialogue: 0,0:07:16.00,0:07:17.74,Main,Orhun,0,0,0,,Sanırım öğle vakti yaklaşıyor.
Dialogue: 0,0:07:18.88,0:07:21.74,Main,Orhun,0,0,0,,Dün, sonuçta kendimi sınırlarıma kadar zorladım.
Dialogue: 0,0:07:22.27,0:07:27.46,Main,Orhun,0,0,0,,Kullandığım tüm o sihirden sonra kötü bir yan etkisi olmaması ne kadar da şanslıyım.
Dialogue: 0,0:07:31.49,0:07:32.77,Main,Orhun,0,0,0,,Selma?
Dialogue: 0,0:07:37.60,0:07:39.44,Main,Selma,0,0,0,,Bugün sizi rahatsız ettiğim için özür dilerim.
Dialogue: 0,0:07:39.44,0:07:40.73,Main,Selma,0,0,0,,Nasıl hissediyorsun?
Dialogue: 0,0:07:41.29,0:07:43.28,Main,Orhun,0,0,0,,Gördüğün gibi, ben iyiyim.
Dialogue: 0,0:07:44.01,0:07:46.89,Main,Orhun,0,0,0,,Bu kadar yolu geldiğiniz için teşekkürler.
Dialogue: 0,0:07:50.00,0:07:55.71,Main,Selma,0,0,0,,Sizin sayenizde, öğretim gezisini kayıpsız tamamladık.
Dialogue: 0,0:07:55.71,0:07:57.24,Main,Selma,0,0,0,,Teşekkür ederiz.
Dialogue: 0,0:07:57.24,0:07:59.10,Main,Orhun,0,0,0,,Selam vermeyi bırak!
Dialogue: 0,0:07:59.10,0:08:01.75,Main,Orhun,0,0,0,,Senin gibi biri olmamalı...
Dialogue: 0,0:08:01.75,0:08:04.24,Main,Selma,0,0,0,,Önemli olan benim pozisyonum değil.
Dialogue: 0,0:08:04.24,0:08:09.42,Main,Selma,0,0,0,,Beni ve yeni askerlerimizi kurtardın.
Dialogue: 0,0:08:09.42,0:08:11.51,Main,Selma,0,0,0,,Size ne kadar teşekkür etsem azdır.
Dialogue: 0,0:08:11.86,0:08:13.06,Main,Orhun,0,0,0,,Selma...
Dialogue: 0,0:08:16.64,0:08:17.75,Main,Selma,0,0,0,,Aslında...
Dialogue: 0,0:08:19.12,0:08:22.00,Main,Selma,0,0,0,,Şu anda klanımıza gelebilir misin?
Dialogue: 0,0:08:22.00,0:08:24.39,Main,Selma,0,0,0,,Liderimiz sizinle görüşmek istiyor.
Dialogue: 0,0:08:24.71,0:08:28.40,Main,Orhun,0,0,0,,Tabii. Bugün hiçbir şey yapmıyorum.
Dialogue: 0,0:08:32.00,0:08:33.94,Main,Vince,0,0,0,,Kısa keseceğim.
Dialogue: 0,0:08:33.94,0:08:36.41,Main,Vince,0,0,0,,\N Night Sky Silver Rabbits'e katılmak ister misiniz?
Dialogue: 0,0:08:37.08,0:08:39.00,Main,Vince,0,0,0,,Sizin ön saflarda hücum oyuncusu olarak oynamanızı istiyoruz.
Dialogue: 0,0:08:39.00,0:08:42.04,Main,Vince,0,0,0,,Birim 1 için, klanımızın en güçlü grubu olan \N.
Dialogue: 0,0:08:43.04,0:08:45.92,Main,Vince,0,0,0,,Ve seni klanımızın teğmen olarak tavsiye etmek istiyorum.
Dialogue: 0,0:08:46.47,0:08:47.49,Main,Orhun,0,0,0,,Teğmen?
Dialogue: 0,0:08:47.49,0:08:49.92,Main,Orhun,0,0,0,,Ben çok gencim...
Dialogue: 0,0:08:49.92,0:08:53.16,Main,Vince,0,0,0,,Yeterli deneyim ve güce sahipsin.
Dialogue: 0,0:08:53.16,0:08:56.67,Main,Vince,0,0,0,,Ve sen eğitimli, ciddi ve çalışkan birisin.
Dialogue: 0,0:08:56.67,0:08:59.08,Main,Vince,0,0,0,,Sen bizim teğmenlerimizden biri olmak için gereken özelliklere sahipsin.
Dialogue: 0,0:09:01.92,0:09:03.79,Main,Vince,0,0,0,,Katılıyorsun, değil mi Selma?
Dialogue: 0,0:09:03.79,0:09:04.69,Main,Selma,0,0,0,,Evet
Dialogue: 0,0:09:05.54,0:09:10.32,Main,Selma,0,0,0,,Klanımızı desteklemek için sizinle birlikte çalışmak isterim.
Dialogue: 0,0:09:11.38,0:09:16.79,Italics,Orhun,0,0,0,,Normalde, herkes böyle bir teklifi hemen kabul ederdi, ama...
Dialogue: 0,0:09:17.29,0:09:18.55,Main,Orhun,0,0,0,,Üzgünüm.
Dialogue: 0,0:09:18.55,0:09:21.08,Main,Orhun,0,0,0,,Bana biraz zaman verebilir misiniz?
Dialogue: 0,0:09:23.44,0:09:26.33,Main,Vince,0,0,0,,Tabii ki. Acele etme.
Dialogue: 0,0:09:27.29,0:09:28.72,Main,Orhun,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:09:30.03,0:09:30.84,Main,Orhun,0,0,0,,O zaman ben gidiyorum.
Dialogue: 0,0:09:31.12,0:09:35.59,Main,Vince,0,0,0,,Oh, ve Maceracıların Loncası seninle görüşmek istiyor.
Dialogue: 0,0:09:36.03,0:09:39.04,Main,Orhun,0,0,0,,Tamam. Oraya gidiyorum.
Dialogue: 0,0:09:47.71,0:09:52.36,Italics,Orhun,0,0,0,,Night Sky Silver \N Rabbits'in beni işe almak istediğine inanamıyorum...
Dialogue: 0,0:09:53.36,0:09:56.16,Italics,Orhun,0,0,0,,Yani yine yoldaşlarım olacak mı?
Dialogue: 0,0:09:59.74,0:10:01.57,Main,Orhun,0,0,0,,O kadar da komik değil, ihtiyar.
Dialogue: 0,0:10:01.57,0:10:03.49,Main,Old Man,0,0,0,,Üzgünüm
Dialogue: 0,0:10:03.49,0:10:06.64,Main,Old Man,0,0,0,,Sen her zaman çok olgun görünüyorsun.
Dialogue: 0,0:10:06.64,0:10:11.25,Main,Old Man,0,0,0,,Bir kez olsun yaşına uygun davrandığını görmek güzel.
Dialogue: 0,0:10:11.84,0:10:14.83,Main,Orhun,0,0,0,,Bu konuda ciddiyim, biliyorsun.
Dialogue: 0,0:10:14.83,0:10:19.12,Main,Orhun,0,0,0,,Onların beni çok takdir ettikleri doğru.
Dialogue: 0,0:10:19.12,0:10:19.89,Main,Orhun,0,0,0,,Ama...
Dialogue: 0,0:10:19.89,0:10:24.63,Main,Old Man,0,0,0,,Sonunda yine kullanılmış ve atılmış olabilirsiniz.
Dialogue: 0,0:10:24.63,0:10:25.39,Main,Orhun,0,0,0,,Evet
Dialogue: 0,0:10:25.63,0:10:28.36,Main,Old Man,0,0,0,,“Kullanılmış” hoş bir kelime olmayabilir,
Dialogue: 0,0:10:28.36,0:10:31.45,Main,Old Man,0,0,0,,ama bence birbirimizi desteklemek
Dialogue: 0,0:10:31.45,0:10:36.53,Main,Old Man,0,0,0,,ve zayıflıklarımızı telafi etmek \N insanların büyüme şeklidir.
Dialogue: 0,0:10:37.01,0:10:40.03,Main,Orhun,0,0,0,,Katılıyorum. Ama...
Dialogue: 0,0:10:40.46,0:10:43.66,Main,Old Man,0,0,0,,O zaman biraz daha düşün.
Dialogue: 0,0:10:47.62,0:10:50.67,Main,Orhun,0,0,0,,En kötü zamanda geldim...
Dialogue: 0,0:10:51.18,0:10:54.49,Main,Guildmaster,0,0,0,,Böylece Kara Ejder 50. katta ortaya çıktı.
Dialogue: 0,0:10:54.49,0:10:56.80,Main,Guildmaster,0,0,0,,ve bunu tek başına yendin, öyle duydum.
Dialogue: 0,0:10:57.23,0:10:59.30,Main,Orhun,0,0,0,,Evet, doğru.
Dialogue: 0,0:10:59.30,0:11:01.76,Main,Derick,0,0,0,,Yalnız mı? Hayır.
Dialogue: 0,0:11:01.76,0:11:06.36,Main,Derick,0,0,0,,Biz onu zaten zayıflatmıştık ve sen de şans eseri son darbeyi vurdun.
Dialogue: 0,0:11:06.36,0:11:10.06,Main,Anneli,0,0,0,,Şanslısın. Hayatını kurtardık.
Dialogue: 0,0:11:10.45,0:11:11.81,Main,Orhun,0,0,0,,Kapa çeneni. Sen bunun bir parçası değilsin.
Dialogue: 0,0:11:11.81,0:11:12.76,Main,Derick,0,0,0,,Ne?
Dialogue: 0,0:11:12.76,0:11:13.94,Main,Luna,0,0,0,,Derick.
Dialogue: 0,0:11:16.84,0:11:19.19,Main,Orhun,0,0,0,,Lonca ustası, izin verirseniz?
Dialogue: 0,0:11:22.49,0:11:28.45,Main,Orhun,0,0,0,,Oliver, neden yeni Enchanter'ınla doğrudan 92. kata gittin?
Dialogue: 0,0:11:28.45,0:11:30.96,Main,Orhun,0,0,0,,Daha önce birçok kez oraya gittiğin için kolay olacağını mı düşündün?
Dialogue: 0,0:11:32.46,0:11:33.72,Main,Orhun,0,0,0,,Haklıyım, değil mi?
Dialogue: 0,0:11:34.24,0:11:36.03,Main,Orhun,0,0,0,,Sana defalarca söyledim.
Dialogue: 0,0:11:36.03,0:11:39.31,Main,Orhun,0,0,0,,güçlenmeden devam etmenin tehlikeli olduğunu.
Dialogue: 0,0:11:39.31,0:11:42.97,Main,Orhun,0,0,0,,Derin katlarda birçok kez birileri neredeyse ölecekti.
Dialogue: 0,0:11:43.25,0:11:45.54,Main,Oliver,0,0,0,,Ve bu yüzden yeni bir Büyücü aldık.
Dialogue: 0,0:11:45.54,0:11:48.76,Main,Oliver,0,0,0,,Seninkinden daha güçlü destek büyüsü olan biriyle,
Dialogue: 0,0:11:48.76,0:11:50.98,Main,Oliver,0,0,0,,Daha derine inebileceğimizi düşündüm.
Dialogue: 0,0:11:51.28,0:11:53.95,Main,Orhun,0,0,0,,Ve bu yüzden beni kovdun.
Dialogue: 0,0:11:53.95,0:11:56.27,Main,Orhun,0,0,0,,Buna kızgın değilim.
Dialogue: 0,0:11:56.27,0:12:00.11,Main,Orhun,0,0,0,,Beni çileden çıkaran şey, Enchanters'ı ne kadar az önemsediğin.
Dialogue: 0,0:12:00.11,0:12:01.97,Main,Oliver,0,0,0,,Onların değerini tam olarak biliyorum!
Dialogue: 0,0:12:01.97,0:12:04.24,Main,Oliver,0,0,0,,Bir büyücü önemlidir, \N bu yüzden yeni bir tane aldım!
Dialogue: 0,0:12:05.84,0:12:08.20,Main,Orhun,0,0,0,,O zaman neden derin katlarla başladın?
Dialogue: 0,0:12:08.20,0:12:10.27,Main,Orhun,0,0,0,,Ne kadar \N konsantrasyonu gerektiğini biliyor musun?
Dialogue: 0,0:12:10.27,0:12:12.75,Main,Orhun,0,0,0,,Bir büyücü için, zindan keşfi yaparken?
Dialogue: 0,0:12:13.91,0:12:17.03,Main,Oliver,0,0,0,,Bir büyücünün yapması gereken tek şey güvenli bir yerde oturmaktır.
Dialogue: 0,0:12:17.03,0:12:19.79,Main,Oliver,0,0,0,,ve ilk buffın etkisi bittiğinde başka bir buff at.
Dialogue: 0,0:12:19.79,0:12:21.18,Main,Oliver,0,0,0,,Çok basit!
Dialogue: 0,0:12:21.63,0:12:24.51,Main,Orhun,0,0,0,,Ciddi misin?
Dialogue: 0,0:12:25.97,0:12:28.51,Main,Oliver,0,0,0,,Tabii ki öyleyim. Bu gerçek!
Dialogue: 0,0:12:30.19,0:12:31.99,Main,Orhun,0,0,0,,Sana inanamıyorum.
Dialogue: 0,0:12:33.92,0:12:36.00,Main,Orhun,0,0,0,,Oliver, 61 saniye.
Dialogue: 0,0:12:36.00,0:12:38.19,Main,Orhun,0,0,0,,Anneli, 134 saniye.
Dialogue: 0,0:12:38.19,0:12:40.53,Main,Orhun,0,0,0,,Derick, 186 saniye.
Dialogue: 0,0:12:41.21,0:12:43.78,Main,Orhun,0,0,0,,Her bir güçlendirmenin süresi budur.
Dialogue: 0,0:12:45.28,0:12:48.76,Main,Orhun,0,0,0,,Bir büyücü, güçlendirmeleri yenilemek için tüm bunları takip etmek zorundadır.
Dialogue: 0,0:12:48.76,0:12:51.86,Main,Orhun,0,0,0,,ve ayrıca grubun geri kalanına \N komutları verin.
Dialogue: 0,0:12:51.86,0:12:54.92,Main,Orhun,0,0,0,,Bu nasıl kolay olabilir? Söyle bana, Oliver!
Dialogue: 0,0:13:02.92,0:13:07.68,Main,Logan,0,0,0,,Sophia, Orhun'un bundan sonra ne yapacağına dair bir şey duydun mu?
Dialogue: 0,0:13:08.12,0:13:10.28,Main,Sophia,0,0,0,,Hayır, hiçbir şey.
Dialogue: 0,0:13:10.28,0:13:14.68,Main,Caroline,0,0,0,,Dün onunla konuşma fırsatı bulamadık.
Dialogue: 0,0:13:15.20,0:13:18.94,Main,Logan,0,0,0,,Sence o da \N Night Sky Silver Rabbits'e katılacak mı?
Dialogue: 0,0:13:18.94,0:13:21.22,Main,Caroline,0,0,0,,Sen de aynı şeyi hissediyorsun, değil mi?
Dialogue: 0,0:13:21.22,0:13:23.12,Main,Caroline,0,0,0,,Biz de tam bunu söylüyorduk!
Dialogue: 0,0:13:23.12,0:13:24.37,Main,Caroline,0,0,0,,Değil mi, Sophia?
Dialogue: 0,0:13:24.37,0:13:25.95,Main,Sophia,0,0,0,,E-Evet.
Dialogue: 0,0:13:25.95,0:13:28.45,Main,Logan,0,0,0,,O zaman neden birlikte ona sormuyoruz?
Dialogue: 0,0:13:28.45,0:13:30.42,Main,Caroline,0,0,0,,Harika bir fikir!
Dialogue: 0,0:13:30.42,0:13:33.15,Main,Caroline,0,0,0,,Ama o nerede?
Dialogue: 0,0:13:33.15,0:13:35.96,Main,Sophia,0,0,0,,Ablam biliyor olabilir!
Dialogue: 0,0:13:43.52,0:13:44.88,Main,Selma,0,0,0,,Orhun Dura...
Dialogue: 0,0:13:45.55,0:13:48.79,Main,Selma,0,0,0,,Onun da bize katılmasını çok isterim.
Dialogue: 0,0:13:49.48,0:13:55.23,Main,Selma,0,0,0,,Ama bir daha asla yoldaşlar isteyecek mi?
Dialogue: 0,0:13:56.44,0:14:00.27,Italics,Selma,0,0,0,,Onlar olmadan da idare edebilir.
Dialogue: 0,0:14:00.79,0:14:02.11,Italics,Selma,0,0,0,,Ve...
Dialogue: 0,0:14:02.52,0:14:04.82,Flashback,Selma,0,0,0,,Büyüm işe yaramayacak mı?
Dialogue: 0,0:14:04.82,0:14:06.11,Flashback,Orhun,0,0,0,,Senin güçlendirmelerine ihtiyacım yok!
Dialogue: 0,0:14:06.11,0:14:07.49,Flashback,Orhun,0,0,0,,Beni alıştığım şeylerden uzaklaştıracaklar!
Dialogue: 0,0:14:07.96,0:14:10.89,Italics,Selma,0,0,0,,O benim yardımıma ihtiyaç duymuyor.
Dialogue: 0,0:14:11.53,0:14:15.82,Italics,Selma,0,0,0,,O, şu anda benden çok daha güçlü biri.
Dialogue: 0,0:14:16.92,0:14:22.20,Italics,Selma,0,0,0,,Ve ona klanı desteklemek için onunla çalışmak istediğimi söyledim, ha?
Dialogue: 0,0:14:22.20,0:14:23.75,Main,Sophia,0,0,0,,Abla
Dialogue: 0,0:14:26.25,0:14:28.11,Main,Selma,0,0,0,,Ne oldu, Sophia?
Dialogue: 0,0:14:28.11,0:14:31.51,Main,Sophia,0,0,0,,Orhun'un nerede yaşadığını biliyor musun?
Dialogue: 0,0:14:31.51,0:14:36.74,Main,Logan,0,0,0,,Onunla görüşüp Rabbits'e katılmasını isteyeceğiz!
Dialogue: 0,0:14:38.05,0:14:39.77,Main,Selma,0,0,0,,Ciddi misin?
Dialogue: 0,0:14:40.66,0:14:43.27,Main,Selma,0,0,0,,Ben de onun katılmasını istiyorum, ama...
Dialogue: 0,0:14:43.92,0:14:48.62,Main,Selma,0,0,0,,Ama onun gücüyle bize ihtiyacı yok.
Dialogue: 0,0:14:50.31,0:14:54.54,Main,Selma,0,0,0,,Bizim seviyemizde, en fazla onu yavaşlatabiliriz.
Dialogue: 0,0:14:55.12,0:14:56.99,Main,Logan,0,0,0,,Bunu biliyoruz.
Dialogue: 0,0:14:57.79,0:15:01.12,Main,Logan,0,0,0,,Ama yine de onun bize katılmasını istiyorum!
Dialogue: 0,0:15:01.12,0:15:04.79,Main,Logan,0,0,0,,Sadece onunla birlikte olmak bana öğrenmem gerekenleri gösterecek, sanırım!
Dialogue: 0,0:15:05.02,0:15:06.22,Main,Caroline,0,0,0,,Evet!
Dialogue: 0,0:15:06.22,0:15:11.30,Main,Caroline,0,0,0,,Eğlenceli çünkü o sana öğrettiğinde, çok daha güçlü olabilirsin!
Dialogue: 0,0:15:11.53,0:15:16.62,Main,Sophia,0,0,0,,Onun bizimle daha fazla vakit geçirmesini çok isterdim...
Dialogue: 0,0:15:17.55,0:15:18.95,Main,Selma,0,0,0,,Sizler...
Dialogue: 0,0:15:19.86,0:15:23.07,Main,Logan,0,0,0,,Şu anda, onu yavaşlatıyor olabiliriz, evet.
Dialogue: 0,0:15:23.07,0:15:25.53,Main,Logan,0,0,0,,Ama bir gün daha güçlü olacağız
Dialogue: 0,0:15:25.53,0:15:29.19,Main,Logan,0,0,0,,ve onu bizi yoldaş olarak tanımasını sağlayalım!
Dialogue: 0,0:15:29.74,0:15:31.21,Italics,Selma,0,0,0,,Doğru.
Dialogue: 0,0:15:31.64,0:15:35.45,Italics,Selma,0,0,0,,Ondan öğrenip daha güçlü olabilirim!
Dialogue: 0,0:15:36.14,0:15:38.95,Italics,Selma,0,0,0,,Görünüşe göre ben de bu konuyu fazla kafama takmışım.
Dialogue: 0,0:15:39.60,0:15:42.67,Main,Selma,0,0,0,,O, Maceracılar Loncası'na gitti. Acele edersen...
Dialogue: 0,0:15:42.67,0:15:43.78,Main,All,0,0,0,,Anladım! Teşekkürler!
Dialogue: 0,0:15:43.78,0:15:44.96,Main,All,0,0,0,,Teşekkürler!
Dialogue: 0,0:15:44.96,0:15:46.57,Main,Caroline,0,0,0,,Hadi gidelim!
Dialogue: 0,0:15:57.56,0:16:02.11,Italics,Orhun,0,0,0,,Şimdi de zorla ışınlanmanın cezası hakkında konuşacaklar, ha?
Dialogue: 0,0:16:02.11,0:16:03.60,Italics,Orhun,0,0,0,,Onların yerinde olmak istemezdim, sanırım.
Dialogue: 0,0:16:07.27,0:16:09.22,Main,Orhun,0,0,0,,Yorgun hissediyorum.
Dialogue: 0,0:16:12.36,0:16:13.28,Main,Orhun,0,0,0,,Onlar mı?
Dialogue: 0,0:16:14.58,0:16:16.20,Main,Orhun,0,0,0,,Onlar burada ne yapıyorlar?
Dialogue: 0,0:16:20.68,0:16:22.37,Main,Caroline,0,0,0,,Bu o!
Dialogue: 0,0:16:25.27,0:16:27.13,Main,Sophia,0,0,0,,Orhun!
Dialogue: 0,0:16:27.13,0:16:28.94,Main,Caroline,0,0,0,,Efendim!
Dialogue: 0,0:16:33.38,0:16:34.77,Main,Orhun,0,0,0,,Kahretsin...
Dialogue: 0,0:16:34.77,0:16:37.05,Main,Orhun,0,0,0,,Dünkü hasar \N beni yakalıyor.
Dialogue: 0,0:16:37.80,0:16:40.51,Main,Orhun,0,0,0,,Ama neden koşuyorum ki?
Dialogue: 0,0:16:40.51,0:16:42.24,Main,Sophia,0,0,0,,Orhun?
Dialogue: 0,0:16:42.24,0:16:43.72,Main,Logan,0,0,0,,Konuşmak istiyoruz!
Dialogue: 0,0:16:43.72,0:16:45.07,Main,Logan,0,0,0,,Neredesin?
Dialogue: 0,0:16:45.65,0:16:47.59,Main,Caroline,0,0,0,,Bu taraftan!
Dialogue: 0,0:16:47.59,0:16:48.65,Main,Orhun,0,0,0,,Hayır
Dialogue: 0,0:16:56.64,0:16:57.85,Main,Logan,0,0,0,,Orhun!
Dialogue: 0,0:16:58.00,0:16:59.91,Main,Sophia,0,0,0,,Orhun!
Dialogue: 0,0:17:01.15,0:17:02.41,Main,Logan,0,0,0,,Nereye gitti?
Dialogue: 0,0:17:02.91,0:17:04.40,Main,Caroline,0,0,0,,Şu tarafa bakalım!
Dialogue: 0,0:17:04.40,0:17:05.12,Main,Logan,0,0,0,,Evet
Dialogue: 0,0:17:05.92,0:17:08.30,Main,Sophia,0,0,0,,Orhun!
Dialogue: 0,0:17:09.16,0:17:10.05,Main,Orhun,0,0,0,,Vay canına.
Dialogue: 0,0:17:15.66,0:17:16.64,Main,Sophia,0,0,0,,Huh?
Dialogue: 0,0:17:16.64,0:17:17.93,Main,Logan,0,0,0,,O burada değil.
Dialogue: 0,0:17:23.03,0:17:24.64,Main,Caroline,0,0,0,,Bu garip.
Dialogue: 0,0:17:24.64,0:17:26.53,Main,Caroline,0,0,0,,Bu tarafa gittiğini biliyorum...
Dialogue: 0,0:17:28.17,0:17:32.19,Main,Old Man,0,0,0,,Neden onlardan kaçınıyorsun?
Dialogue: 0,0:17:32.64,0:17:37.45,Main,Orhun,0,0,0,,Başka bir partiye katılmayacağıma karar verdim.
Dialogue: 0,0:17:37.79,0:17:41.61,Main,Orhun,0,0,0,,Ama bu onları üzecektir.
Dialogue: 0,0:17:42.08,0:17:45.12,Main,Old Man,0,0,0,,Yani onlardan kaçınıyor musun?
Dialogue: 0,0:17:47.91,0:17:50.59,Main,Old Man,0,0,0,,Senin için çok önemli gibi görünüyorlar.
Dialogue: 0,0:17:53.10,0:17:54.57,Main,Caroline,0,0,0,,Bu tuhaf.
Dialogue: 0,0:17:54.57,0:17:57.84,Main,Caroline,0,0,0,,Neden bizden kaçınıyor?
Dialogue: 0,0:17:57.84,0:18:02.10,Main,Caroline,0,0,0,,Belki de Night Sky Silver Rabbits'e katılmak istemiyordur.
Dialogue: 0,0:18:02.10,0:18:06.35,Main,Logan,0,0,0,,Ve bu yüzden hepimiz ona soracağız, değil mi?
Dialogue: 0,0:18:06.35,0:18:10.86,Main,Sophia,0,0,0,,P-Peki ya gerçekten hayır derse?
Dialogue: 0,0:18:10.86,0:18:15.61,Main,Logan,0,0,0,,O zaman Rabbits'ten ayrılıp onun çırağı olacağım!
Dialogue: 0,0:18:15.61,0:18:18.48,Main,Caroline,0,0,0,,Haksızlık! O zaman ben de istiyorum!
Dialogue: 0,0:18:18.48,0:18:20.37,Main,Caroline,0,0,0,,Ve tabii ki Sophia da öyle, değil mi?
Dialogue: 0,0:18:21.04,0:18:22.46,Main,Sophia,0,0,0,,Um...
Dialogue: 0,0:18:22.46,0:18:27.12,Main,Sophia,0,0,0,,Ona veda etmek istemiyorum.
Dialogue: 0,0:18:28.04,0:18:31.37,Main,Old Man,0,0,0,,Sana çok hayran görünüyorlar.
Dialogue: 0,0:18:31.37,0:18:33.16,Main,Orhun,0,0,0,,Kes şunu, ihtiyar.
Dialogue: 0,0:18:33.16,0:18:33.92,Main,Orhun,0,0,0,,Ben
Dialogue: 0,0:18:33.92,0:18:41.07,Main,Old Man,0,0,0,,Buraya koştuğunda, sanki bundan zevk alıyormuşsun gibi görünüyordun.
Dialogue: 0,0:18:43.43,0:18:48.45,Flashback,Old Man,0,0,0,,Ait olabileceğin bir yer aradığını biliyorum.
Dialogue: 0,0:18:48.45,0:18:52.47,Flashback,Old Man,0,0,0,,Ama bence yalnız kalmak zorunda değilsin.
Dialogue: 0,0:18:52.47,0:18:56.67,Flashback,Old Man,0,0,0,,Diğerlerinin yanında yerinizi bulabilirsiniz.
Dialogue: 0,0:18:57.17,0:18:58.65,Italics,Orhun,0,0,0,,Ben nereye aidim?
Dialogue: 0,0:19:09.31,0:19:10.96,Main,Sophia,0,0,0,,Orhun?
Dialogue: 0,0:19:12.16,0:19:13.46,Main,Orhun,0,0,0,,Sophia!
Dialogue: 0,0:19:14.42,0:19:18.67,Main,Sophia,0,0,0,,Dün bizi kurtardığınız için teşekkür ederiz!
Dialogue: 0,0:19:18.67,0:19:19.84,Main,Orhun,0,0,0,,Oh, Hayır
Dialogue: 0,0:19:19.84,0:19:22.25,Main,Sophia,0,0,0,,Bütün gün seni aradık!
Dialogue: 0,0:19:22.25,0:19:24.35,Main,Sophia,0,0,0,,Neredeydin?
Dialogue: 0,0:19:25.08,0:19:28.85,Main,Orhun,0,0,0,,Şey... Şehri dolaşıyordum.
Dialogue: 0,0:19:28.85,0:19:32.16,Main,Orhun,0,0,0,,Bu saatte burada ne yapıyorsun?
Dialogue: 0,0:19:32.16,0:19:34.84,Main,Sophia,0,0,0,,Klan merkezimize yakın.
Dialogue: 0,0:19:34.84,0:19:37.36,Main,Sophia,0,0,0,,En sevdiğim yerlerden biri.
Dialogue: 0,0:19:37.68,0:19:38.88,Main,Orhun,0,0,0,,En sevdiğiniz yerler?
Dialogue: 0,0:19:38.88,0:19:40.04,Main,Sophia,0,0,0,,Evet
Dialogue: 0,0:19:40.04,0:19:43.45,Main,Sophia,0,0,0,,Buradaki ay çok güzel.
Dialogue: 0,0:19:45.18,0:19:49.47,Main,Sophia,0,0,0,,Tamamen karanlık olsa bile,
Dialogue: 0,0:19:49.47,0:19:52.37,Main,Sophia,0,0,0,,Ay hala parlak bir şekilde parlıyor mu?
Dialogue: 0,0:19:52.72,0:19:58.38,Main,Sophia,0,0,0,,Bu yüzden, aya baktığımda bana güç verdiğini hissediyorum.
Dialogue: 0,0:19:58.91,0:20:03.19,Main,Sophia,0,0,0,,\N Night Sky Silver Rabbits isminin nereden geldiğini biliyor musunuz?
Dialogue: 0,0:20:03.19,0:20:04.01,Main,Orhun,0,0,0,,Hayır
Dialogue: 0,0:20:04.01,0:20:08.48,Main,Sophia,0,0,0,,Ay, aynı zamanda “gecenin rehberi” olarak da adlandırılır.
Dialogue: 0,0:20:08.48,0:20:09.54,Main,Sophia,0,0,0,,Ve
Dialogue: 0,0:20:09.54,0:20:14.02,Main,Sophia,0,0,0,,Gece Gökyüzü Gümüş Tavşanlar,'nin maceracılar için \Nbir rehber olmasını istiyor.
Dialogue: 0,0:20:14.38,0:20:17.16,Main,Sophia,0,0,0,,İsmin kaynağı da budur.
Dialogue: 0,0:20:18.01,0:20:19.45,Italics,Orhun,0,0,0,,Bir rehber...
Dialogue: 0,0:20:21.48,0:20:25.92,Italics,Orhun,0,0,0,,Bir keresinde biriyle bu konuyu konuşmuştum...
Dialogue: 0,0:20:27.49,0:20:29.78,Main,Sophia,0,0,0,,U-Um... Orhun!
Dialogue: 0,0:20:30.29,0:20:34.54,Main,Sophia,0,0,0,,Lütfen \N Night Sky Silver Rabbits'e katılır mısınız?
Dialogue: 0,0:20:34.54,0:20:38.54,Main,Sophia,0,0,0,,Seninle kalmak istiyorum!
Dialogue: 0,0:20:40.02,0:20:41.66,Main,Orhun,0,0,0,,Hey, Sophia.
Dialogue: 0,0:20:41.66,0:20:45.06,Main,Orhun,0,0,0,,Sizin için \N Night Sky Silver Rabbits nasıl bir yer?
Dialogue: 0,0:20:45.06,0:20:47.82,Main,Sophia,0,0,0,,Bana mı?
Dialogue: 0,0:20:47.82,0:20:48.81,Main,Orhun,0,0,0,,Evet
Dialogue: 0,0:20:49.18,0:20:51.08,Main,Sophia,0,0,0,,Şey...
Dialogue: 0,0:20:51.80,0:20:56.86,Main,Sophia,0,0,0,,Bana çok şey öğrettiler,
Dialogue: 0,0:20:56.86,0:20:59.19,Main,Sophia,0,0,0,,bana o kadar çok gülümseme verdi ki...
Dialogue: 0,0:20:59.19,0:21:03.46,Main,Sophia,0,0,0,,Burası benim evim diyebilmekten gurur duyuyorum!
Dialogue: 0,0:21:03.46,0:21:06.36,Main,Sophia,0,0,0,,Benim için, burası ait olduğum yer!
Dialogue: 0,0:21:08.85,0:21:11.58,Main,Orhun,0,0,0,,Ait olduğun yer...
Dialogue: 0,0:21:19.10,0:21:21.05,Main,Vince,0,0,0,,O zaman cevabını bulmuşsun gibi görünüyor.
Dialogue: 0,0:21:21.05,0:21:22.92,Main,Orhun,0,0,0,,Evet, Vince...
Dialogue: 0,0:21:23.49,0:21:25.26,Main,Orhun,0,0,0,,Hayır, Liderim
Dialogue: 0,0:21:26.29,0:21:29.46,Main,Orhun,0,0,0,,Lütfen beni \N Night Sky Silver Rabbits'e kabul edin.
Dialogue: 0,0:21:32.80,0:21:34.27,Main,Vince,0,0,0,,Sizi aramızda görmekten mutluluk duyuyoruz.
Dialogue: 0,0:21:36.66,0:21:39.52,Main,Selma,0,0,0,,Tebrikler, Orhun!
Dialogue: 0,0:21:39.52,0:21:41.46,Main,Selma,0,0,0,,İşte guild üniforman!
Dialogue: 0,0:21:41.46,0:21:43.40,Main,Selma,0,0,0,,Deneyin!
Dialogue: 0,0:21:43.40,0:21:45.43,Main,Logan,0,0,0,,Sophia, bu doğru mu?
Dialogue: 0,0:21:45.43,0:21:46.00,Main,Sophia,0,0,0,,Evet
Dialogue: 0,0:21:46.00,0:21:47.41,Main,Caroline,0,0,0,,Yaşasın!
Dialogue: 0,0:22:02.01,0:22:05.48,Main,Orhun,0,0,0,,Bundan böyle, ben \N Night Sky Silver Rabbits'in bir parçasıyım.
Dialogue: 0,0:22:06.30,0:22:08.54,Main,Orhun,0,0,0,,Sizinle çalışmayı dört gözle bekliyorum.
